{
  "name": "@dsh-remora/cli",
  "version": "0.1.7",
  "private": true,
  "description": "remora: the Remora command line. Distributed as standalone binaries on GitHub Releases, not on npm.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "remora": "./dist/remora.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-reporter=spec --disable-warning=ExperimentalWarning \"test/*.test.ts\"",
    "build:binary": "node scripts/build-binaries.mjs"
  },
  "devDependencies": {
    "@dsh-remora/protocol": "workspace:*",
    "postject": "1.0.0-alpha.6"
  }
}
