{
  "name": "dsh-remora-workspace",
  "private": true,
  "type": "module",
  "description": "Self-hosted remote control for DSH (DeepSeek Harness). Unofficial.",
  "license": "MIT",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "tsc -b",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm vendor:check",
    "pack:plugin": "pnpm --filter dsh-remora run pack:plugin",
    "vendor:sync": "node scripts/vendor-protocol.mjs",
    "vendor:check": "node scripts/vendor-protocol.mjs --check",
    "hub:check": "npm --prefix hub ci && npm --prefix hub run typecheck && npm --prefix hub test",
    "e2e:install": "npm --prefix e2e ci --no-audit --no-fund",
    "e2e": "node e2e/run.mjs",
    "e2e:browser": "node e2e/run.mjs --only=browser",
    "e2e:flow": "node e2e/run.mjs --only=flow",
    "check:version": "node scripts/check-version.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
