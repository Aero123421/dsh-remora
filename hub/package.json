{
  "name": "remora-hub",
  "version": "0.0.1",
  "private": true,
  "description": "Remora hub: a small self-hosted Cloudflare Worker that relays between your DSH hosts and ChatGPT, Claude, the CLI and the HTTP API.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p test",
    "test": "node --test --test-reporter=spec --disable-warning=ExperimentalWarning \"test/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "6.0.3",
    "wrangler": "4.141.0"
  }
}
